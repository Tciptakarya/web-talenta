// Prisma schema — Website Talenta Cipta Karya (PRD v2.1, §5)
// Vercel/Prod: PostgreSQL (Neon/Supabase). Lokal juga bisa pakai Postgres yang sama.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Kategori kelas/program — DINAMIS, dikelola dari Admin > Kategori Kelas.
/// Relasi: 1 Category → N Program, 1 Category → N GalleryImage.
model Category {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique // otomatis dari name, unik
  description   String? // dipakai sebagai deskripsi halaman /kelas/[slug]
  image         String? // thumbnail opsional
  isActive      Boolean        @default(true)
  programs      Program[]
  galleryImages GalleryImage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// Program/kelas — judul/deskripsi bisa disunting dari /admin/program,
/// berelasi ke Category (nullable agar data lama tidak rusak saat migrasi).
model Program {
  id          Int       @id @default(autoincrement())
  judul       String
  slug        String    @unique
  deskripsi   String
  urutan      Int       @default(0)
  isActive    Boolean   @default(true)
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  gallery     GalleryImage[]
  jadwal      JadwalPelatihan[]
  materi      MateriPelatihan[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Foto galeri — URL menunjuk ke Vercel Blob atau /uploads (mode lokal),
/// berelasi ke Category (query by relasi, bukan string hardcode).
model GalleryImage {
  id         Int       @id @default(autoincrement())
  url        String
  caption    String
  alt        String?
  urutan     Int       @default(0)
  uploadedAt DateTime  @default(now())
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  programId  Int? // opsional: kaitkan foto ke program tertentu
  program    Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  nama      String
  peran     String // peran/program, mis. "Alumni Pelatihan Barista"
  pesan     String
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Cadangan pesan form kontak — tetap tersimpan meski pengiriman email gagal (§8)
model ContactMessage {
  id          Int      @id @default(autoincrement())
  nama        String
  email       String
  pesan       String
  statusEmail String   @default("pending") // "sent" | "failed" | "skipped"
  createdAt   DateTime @default(now())
}

/// 1 akun admin — password di-hash bcrypt
model AdminUser {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  passwordResetTokens PasswordResetToken[]
}

/// Token reset password — sekali pakai, 30 menit, simpan hash saja (§6, §7)
model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  adminUserId Int
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([expiresAt])
}

/// Jadwal pelatihan — 1 Program → N jadwal (slot hari/jam berbeda).
/// Ditampilkan di Admin > Jadwal Pelatihan & halaman publik /kelas/[slug].
model JadwalPelatihan {
  id         Int      @id @default(autoincrement())
  programId  Int
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  instruktur String? // teks bebas, mis. "Budi Santoso"
  ruangan    String? // teks bebas, mis. "Ruangan Praktek"
  hari       String // diturunkan otomatis dari `tanggal` (zona Asia/Jakarta); jadwal lama tanpa tanggal tetap memakai nilai lama
  tanggal    DateTime? // jadwal satu kali: tanggal+jam disimpan di tengah malam WIB; kosong = jadwal mingguan lama
  jamMulai   String // "08:00" (HH:MM)
  jamAkhir   String // "10:00" (HH:MM)
  urutan     Int     @default(0)
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([programId])
  @@index([tanggal])
}

/// Materi pelatihan — file terupload (Blob//uploads) ATAU link eksternal (wajib salah satu).
/// Tipe: "VIDEO" | "MODUL CETAK" | "PDF" | "SLIDE" (divalidasi Zod).
model MateriPelatihan {
  id        Int      @id @default(autoincrement())
  programId Int
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  judul     String
  tipe      String
  fileUrl   String? // hasil upload via storeImage (Vercel Blob / public/uploads)
  linkUrl   String? // URL eksternal (YouTube, GDrive, dll.)
  urutan    Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
}
