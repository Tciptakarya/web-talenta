# ---------------------------------------------------------------------------
# Salin file ini jadi .env lalu isi nilainya. Semua variabel di bawah punya
# fallback aman untuk mode lokal (lihat README).
# ---------------------------------------------------------------------------

# --- Database (Prisma) ---
# Lokal: SQLite sudah jalan otomatis lewat file prisma/dev.db
# Produksi (Vercel + Neon/Supabase): ganti provider di prisma/schema.prisma
# menjadi "postgresql" lalu isi DATABASE_URL dengan connection string Neon.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth v5) ---
# Generate: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# --- Akun admin (dipakai saat npm run db:seed) ---
ADMIN_EMAIL="admin@talentaciptakarya.com"
ADMIN_PASSWORD="ganti-password-admin"

# --- Email (Resend) ---
# Kosongkan dulu = pesan tetap tersimpan di database (inbox /admin/pesan),
# hanya email notifikasi yang dilewati. Isi nanti untuk aktifkan notifikasi.
RESEND_API_KEY=""
CONTACT_EMAIL_TO="info@talentaciptakarya.com"
# Pengirim harus domain yang sudah diverifikasi di Resend.
CONTACT_EMAIL_FROM="onboarding@resend.dev"

# --- Penyimpanan foto (Vercel Blob) ---
# Kosongkan dulu = foto disimpan ke folder public/uploads (mode lokal).
# Isi token dari dashboard Vercel > Storage > Blob untuk produksi.
BLOB_READ_WRITE_TOKEN=""

# --- URL publik situs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
