# ---------------------------------------------------------------------------
# Salin file ini jadi .env lalu isi nilainya. Semua variabel di bawah punya
# fallback aman untuk mode lokal (lihat README).
# ---------------------------------------------------------------------------

# --- Database (Prisma) ---
# Lokal: SQLite sudah jalan otomatis lewat file prisma/dev.db
# Produksi (Vercel + Neon/Supabase): ganti provider di prisma/schema.prisma
# menjadi "postgresql" lalu isi DATABASE_URL dengan connection string Neon.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth v5) ---
# Generate: npx auth secret  (atau: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-string-acak-panjang"
AUTH_TRUST_HOST="true"

# --- Akun admin (dipakai saat npm run db:seed) ---
ADMIN_EMAIL="info@talentaciptakarya.com"
ADMIN_PASSWORD="ganti-password-admin"

# --- Email (Resend) ---
# Kosongkan dulu = pesan tetap tersimpan di database (inbox /admin/pesan),
# hanya email notifikasi yang dilewati. Isi nanti untuk aktifkan notifikasi.
RESEND_API_KEY=""
CONTACT_EMAIL_TO="info@talentaciptakarya.com"
# Pengirim harus domain yang sudah diverifikasi di Resend.
CONTACT_EMAIL_FROM="Talenta Cipta Karya <info@talentaciptakarya.com>"

# --- Email Center (Admin > Email) ---
# API key KHUSUS panel (boleh sama dengan RESEND_API_KEY; bila kosong dipakai
# RESEND_API_KEY). Jangan pernah dikirim ke browser.
PANEL_RESEND_API_KEY=""
# Secret webhook Resend untuk status pengiriman nyata (delivered/bounced).
# Kosong = webhook menolak semua event (status tidak diklaim).
RESEND_WEBHOOK_SECRET=""

# --- Email masuk via IMAP (mailbox info@) ---
# Kosong = Email Center tetap berfungsi untuk kirim, tapi Inbox belum aktif.
MAIL_IMAP_HOST="imap.hostinger.com"
MAIL_IMAP_PORT="993"
MAIL_IMAP_USER="info@talentaciptakarya.com"
MAIL_IMAP_PASSWORD=""
MAIL_IMAP_SECURE="true"
# Batas waktu per operasi IMAP (ms) — opsional.
MAIL_IMAP_TIMEOUT_MS="20000"

# --- Penyimpanan foto (Vercel Blob) ---
# Kosongkan dulu = foto disimpan ke folder public/uploads (mode lokal).
# Isi token dari dashboard Vercel > Storage > Blob untuk produksi.
BLOB_READ_WRITE_TOKEN=""

# --- URL publik situs ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
